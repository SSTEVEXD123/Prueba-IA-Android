<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="JarvisApp/models/"/>
        <exclude domain="external" path="JarvisApp/generated_images/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <include domain="external" path="JarvisApp/files/"/>
        <include domain="external" path="JarvisApp/generated_pdfs/"/>
    </device-transfer>
</data-extraction-rules>
