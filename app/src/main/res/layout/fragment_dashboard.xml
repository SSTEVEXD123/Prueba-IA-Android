<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Panel de Control"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewJarvisVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"
            tools:text="Jarvis App v1.0.0" />

        <!-- ─── TARJETA: ESTADO DE MODELOS ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 Modelos Activos"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLlmStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LLM ✗ Inactivo"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        android:textColor="@color/text_secondary"
                        style="@style/Widget.MaterialComponents.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSdStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SD ✗ Inactivo"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        android:textColor="@color/text_secondary"
                        style="@style/Widget.MaterialComponents.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoondreamStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moondream ✗"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        android:textColor="@color/text_secondary"
                        style="@style/Widget.MaterialComponents.Chip.Filter" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── TARJETA: RAM ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="💾 Memoria RAM"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewRamPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="72%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBarRam"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    app:indicatorColor="@color/accent_primary"
                    app:trackColor="@color/bg_input"
                    app:trackCornerRadius="4dp"
                    tools:progress="72" />

                <TextView
                    android:id="@+id/textViewRamUsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="5.8 GB / 8.0 GB" />

                <TextView
                    android:id="@+id/textViewAppMemory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    tools:text="App: 342MB / 512MB" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── TARJETA: CPU ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Uso de CPU"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewCpuPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_warning"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="45%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBarCpu"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    app:indicatorColor="@color/color_warning"
                    app:trackColor="@color/bg_input"
                    app:trackCornerRadius="4dp"
                    tools:progress="45" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── TARJETA: ALMACENAMIENTO ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="📁 Almacenamiento"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewStoragePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_success"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="38%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBarStorage"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    app:indicatorColor="@color/color_success"
                    app:trackColor="@color/bg_input"
                    app:trackCornerRadius="4dp"
                    tools:progress="38" />

                <TextView
                    android:id="@+id/textViewStorageUsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="47.2 GB / 128 GB" />

                <TextView
                    android:id="@+id/textViewJarvisSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    tools:text="JarvisApp: 3.2 GB" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── TARJETA: INFO DISPOSITIVO ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Dispositivo"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Modelo:" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/textViewDeviceModel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" tools:text="Samsung Galaxy S22" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Android:" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/textViewAndroidVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" tools:text="Android 14 (API 34)" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Arquitectura:" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/textViewCpuArch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" tools:text="arm64-v8a" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── TARJETA: ESTADÍSTICAS DE USO ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Estadísticas"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/textViewConvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent_primary" android:textSize="28sp" android:textStyle="bold" tools:text="12" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chats" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/textViewImgCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/color_success" android:textSize="28sp" android:textStyle="bold" tools:text="7" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Imágenes" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
