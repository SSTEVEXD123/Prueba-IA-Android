<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/accent_primary"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila 1: nombre + tipo chip + status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/textViewModelName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Phi-3 Mini (3.8B Q4)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModelType"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="🧠 LLM"
                android:textSize="11sp"
                android:layout_marginStart="6dp"
                app:chipBackgroundColor="@color/accent_primary_10"
                android:textColor="@color/accent_primary"
                app:chipMinHeight="28dp"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Activo"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                app:chipBackgroundColor="#1A2ECC71"
                android:textColor="@color/color_success"
                app:chipMinHeight="28dp"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Descripción -->
        <TextView
            android:id="@+id/textViewModelDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="10dp"
            tools:text="Modelo ultra-ligero de Microsoft. Ideal para dispositivos con 4GB RAM." />

        <!-- Fila 2: quantización + contexto + tamaño -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/textViewQuantization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/accent_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                tools:text="Q4_K_M" />

            <TextView
                android:id="@+id/textViewContextLen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"
                tools:text="4K ctx" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textViewSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                tools:text="2400 MB" />
        </LinearLayout>

        <!-- Barra de progreso de descarga -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressDownload"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:indicatorColor="@color/accent_primary"
            app:trackColor="@color/bg_input"
            app:trackCornerRadius="3dp"
            tools:progress="45"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textViewProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_primary"
            android:textSize="12sp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            tools:text="1200 / 2400 MB"
            tools:visibility="visible" />

        <!-- Fila 3: Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                android:text="Eliminar"
                android:textSize="12sp"
                app:strokeColor="@color/color_error"
                android:textColor="@color/color_error"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonActivate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:text="Activar"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_secondary"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDownload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="14dp"
                android:text="Descargar"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_primary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
