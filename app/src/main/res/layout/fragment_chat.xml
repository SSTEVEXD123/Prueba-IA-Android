<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ToolBar superior con nombre del modelo -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- Icono Jarvis (pulso animado) -->
            <View
                android:id="@+id/viewJarvisPulse"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_accent"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewModelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jarvis"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Phi-3 Mini (3.8B)" />

                <TextView
                    android:id="@+id/textViewStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Modelo listo ✓"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Botón nueva conversación -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNewChat"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Nuevo"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                app:strokeColor="@color/accent_primary"
                android:textColor="@color/accent_primary" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Progress bar carga de modelo -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressModelLoading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:indicatorColor="@color/accent_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:trackColor="@color/bg_surface"
        tools:visibility="visible" />

    <!-- Lista de mensajes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressModelLoading" />

    <!-- Estado vacío -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/layoutInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressModelLoading">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jarvis"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="Tu asistente personal con IA local.\n¿En qué puedo ayudarte hoy?"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Indicador de generación -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressGenerating"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:indicatorColor="@color/accent_primary"
        app:layout_constraintBottom_toTopOf="@id/layoutInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="@color/bg_surface"
        tools:visibility="visible" />

    <!-- Barra de entrada inferior -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Campo de texto -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:boxBackgroundColor="@color/bg_input"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusTopStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusBottomEnd="24dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Escribe un mensaje..."
                    android:imeOptions="actionSend"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón voz -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonVoice"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="23dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_mic"
                android:contentDescription="Activar micrófono"
                app:backgroundTint="@color/bg_button_secondary" />

            <!-- Botón enviar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSend"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="23dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_send"
                android:contentDescription="Enviar mensaje"
                app:backgroundTint="@color/accent_primary" />

            <!-- Botón detener (visible durante generación) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStop"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:visibility="gone"
                app:cornerRadius="23dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:icon="@drawable/ic_stop"
                android:contentDescription="Detener generación"
                app:backgroundTint="@color/color_error" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
